*.iml

# Local Android signing material. The release keystore in handoff is intentionally
# tracked at the owner's request (the repository is public; see signing/README.md).
*.jks
*.keystore
*.p12
!handoff/NoirP2P-release-keystore.p12
key.properties
signing/*private*.pem
signing/*PASSWORD*.txt

# CI-generated handoff artifacts (download from GitHub Actions)
handoff/*.apk
handoff/*.aab
handoff/*.zip

# OS/editor noise
.DS_Store
Thumbs.db
