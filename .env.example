# ============================================================
#  Для Railway / Render этот файл НЕ НУЖЕН — всё само.
#  Только для VPS через docker compose.
# ============================================================

# Оставь пустым = UUID вычислится сам из домена.
# UUID=xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx

# Должен совпадать с path в клиентской ссылке (обычно не меняй)
XHTTP_PATH=/api/uploadFile/
XHTTP_MODE=packet-up

# Твой домен на VPS (для подсказки ссылки в логах)
DOMAIN=vpn.example.com

PORT=8080
