# ============================================================================
#  Аниме-бот AniLibria -> Telegram (MTProto). Скопируй в .env и меняй под себя.
#  Все ключи уже вшиты в config.py — здесь только переопределения.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=8877653509:AAHkFOL8Vj6aqICiOg9Xwpn9ONE92affKtc
# Можно указать конкретную пару из api_keys.py; если не указать — берётся вшитая
# (Public Win Beta) + авто-перебор остальных при ошибке авторизации.
# API_ID=2040
# API_HASH=b18441a1ff607e10a989891a5462e627
# API_KEYS_ROTATION=1        # перебор пар api_id/api_hash при ошибках запуска
# API_KEYS_RANDOMIZE=0       # 1 = случайная пара из списка на старте

# --- Доступ -----------------------------------------------------------------
PUBLIC_BOT=1                 # 1 = всем, 0 = только OWNER_ID/ALLOWED_USERS
OWNER_ID=0                   # свой ID: команда /id в боте
# ALLOWED_USERS=111111111,222222222

# --- Файлы и лимиты (MTProto: до 2000 МБ) -----------------------------------
MAX_FILE_MB=2000
MAX_CACHE_GB=25
CONCURRENT_DOWNLOADS=2
CONCURRENT_UPLOADS=2
DEFAULT_QUALITY=1080
QUALITY_CHOICES=1080,720,480
TRY_LOWER_QUALITY_ON_TOOBIG=1
SEND_AS_DOCUMENT=0
ENABLE_FILE_INTAKE=1
EPISODES_PER_PAGE=12
PROGRESS_INTERVAL=4.0

# --- Скорость скачивания (сегменты HLS качаются параллельно и адаптивно) -----
HLS_PARALLEL=1               # 1 = параллельная загрузка сегментов + локальный remux
HLS_CONNECTIONS=8            # потолок одновременных соединений к CDN
HLS_START_CONNECTIONS=6      # стартуем сразу с 6 потоков (дальше плавный разгон до потолка)
HLS_RAMP_AFTER=10            # +1 соединение за столько успешных сегментов
HLS_JITTER=0.35              # разброс старта запросов (сек), чтобы не бить залпом
HLS_SEGMENT_RETRIES=4        # повторы на сетевые сбои
HLS_MAX_RATE_HITS=40         # сколько раз терпим лимит CDN, прежде чем уйти в 1 поток
HLS_MAX_FORBIDDEN=6          # сколько 403 терпим (похоже на бан IP / гео-ограничение)
HLS_BACKOFF_BASE=2.0         # база экспоненциальной паузы при 429
HLS_RETRY_AFTER_MAX=180      # дольше столько секунд Retry-After не ждём
HLS_MAX_TOTAL_WAIT=900       # суммарное ожидание лимитов на одну серию
HLS_LONG_PAUSE=20.0          # пауза перед повторной попыткой докачки

# --- диск -------------------------------------------------------------------
# Удалять mp4/превью/сегменты сразу после успешной отправки в Telegram.
# Повторные запросы всё равно мгновенные: file_id уже в базе, файл хранит Telegram.
DELETE_AFTER_SEND=1

# --- AniLibria / AniLiberty API v1 ------------------------------------------
ANILIBRIA_MIRRORS=https://anilibria.top,https://api.anilibria.app
SEARCH_LIMIT=20
INLINE_LIMIT=30
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# --- ffmpeg -----------------------------------------------------------------
FFMPEG=ffmpeg
FFPROBE=ffprobe
FFMPEG_THREADS=0

# --- Хранилище --------------------------------------------------------------
DATA_DIR=/data
DOWNLOAD_DIR=/data/cache
SESSION_DIR=/data/sessions
DB_PATH=/data/anime_bot.sqlite3

# --- Прокси (если блокируют Telegram/AniLibria) -----------------------------
# TG_PROXY=socks5://user:pass@host:1080
# ANILIBRIA_PROXY=http://user:pass@host:3128

# --- Прочее -----------------------------------------------------------------
# HEALTH_PORT=8080           # мини HTTP /health для PaaS (Render/Railway)
LOG_LEVEL=INFO
