rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Справочник пользователей: uid -> {name, username, token, pub}
    // Читать может любой залогиненный, писать — только владелец.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // username -> uid. Занять можно только свободный, удалить/переписать — нельзя.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(db)/documents/usernames/$(name));
      allow update, delete: if false;
    }
  }
}
