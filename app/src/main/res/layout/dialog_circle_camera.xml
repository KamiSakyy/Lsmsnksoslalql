<?xml version="1.0" encoding="utf-8"?>
<!-- Circular video note recorder, mirrors the web .circle-recorder-modal markup. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:cardBackgroundColor="@color/tsuyu_black"
            app:cardCornerRadius="130dp"
            app:strokeColor="@color/tsuyu_white"
            app:strokeWidth="4dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/circle_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/circle_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:fontFamily="sans-serif-medium"
            android:text="0:00"
            android:textColor="@color/tsuyu_white"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/circle_switch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="@dimen/space_lg"
                android:background="@drawable/bg_circle_sec"
                android:clickable="true"
                android:contentDescription="@string/circle_switch_camera"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/tsuyu_white" />

            <ImageView
                android:id="@+id/circle_torch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="@dimen/space_lg"
                android:background="@drawable/bg_circle_sec"
                android:clickable="true"
                android:contentDescription="@string/circle_torch"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_flash"
                app:tint="@color/tsuyu_white" />

            <ImageView
                android:id="@+id/circle_cancel"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="@dimen/space_lg"
                android:background="@drawable/bg_circle_sec"
                android:clickable="true"
                android:contentDescription="@string/circle_cancel"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                app:tint="@color/tsuyu_white" />

            <ImageView
                android:id="@+id/circle_action"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_camera"
                android:clickable="true"
                android:contentDescription="@string/circle_record"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_record_dot"
                app:tint="@color/tsuyu_danger" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
