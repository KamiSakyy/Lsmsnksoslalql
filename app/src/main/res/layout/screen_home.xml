<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/home_toolbar"
        style="@style/Widget.Tsuyu.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:menu="@menu/home_toolbar"
        app:subtitle="@string/home_subtitle"
        app:title="@string/nav_chats" />

    <LinearLayout
        android:id="@+id/home_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/home_filter_all"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_small"
            android:background="@drawable/bg_filter_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/home_filter_all"
            android:textColor="@color/tsuyu_blue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/home_filter_unread"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/icon_button_small"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_filter_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/home_filter_unread"
            android:textColor="@color/tsuyu_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/home_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_input"
        android:gravity="center"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/home_offline_banner"
        android:textAppearance="@style/TextAppearance.Tsuyu.Caption"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chats_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="104dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/home_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xs"
            android:visibility="gone">

            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3xl"
            android:paddingEnd="@dimen/space_3xl">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_menu_icon">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_chat"
                    app:tint="@color/tsuyu_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/home_empty_title"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/no_chats_title"
                android:textAppearance="@style/TextAppearance.Tsuyu.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/home_empty_description"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/no_chats_description"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_find_people"
                style="@style/Widget.Tsuyu.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/find_people" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/home_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_lg"
            android:contentDescription="@string/find_people"
            android:visibility="gone"
            app:backgroundTint="@color/tsuyu_blue"
            app:fabSize="normal"
            app:shapeAppearanceOverlay="@style/TsuyuCircleShape"
            app:srcCompat="@drawable/ic_compose"
            app:tint="@color/tsuyu_white" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_black"
        android:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.Tsuyu.NavLabelActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Tsuyu.NavLabel"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
