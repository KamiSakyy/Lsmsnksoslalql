<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <!-- Верхняя панель (Header): ультра-чистая шапка 2026 -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/home_menu_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_btn_strong"
            android:clickable="true"
            android:contentDescription="@string/home_menu"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/tsuyu_white" />

        <LinearLayout
            android:id="@+id/home_title_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_title_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/tsuyu_white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/home_title_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/home_subtitle"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/home_encrypt_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/home_encryption"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/tsuyu_white" />
    </LinearLayout>

    <!-- Строка поиска: скругленная pill-форма 2026 без резких рамок -->
    <LinearLayout
        android:id="@+id/home_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_home_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:contentDescription=""
                android:src="@drawable/ic_search"
                app:tint="@color/tsuyu_secondary" />

            <EditText
                android:id="@+id/home_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/home_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/tsuyu_white"
                android:textColorHint="@color/tsuyu_time"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Фильтры / Вкладки папок: гладкий скролл -->
    <HorizontalScrollView
        android:id="@+id/home_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_header"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/home_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_input"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/home_offline_banner"
        android:textAppearance="@style/TextAppearance.Tsuyu.Caption"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_divider_soft" />

    <!-- Основной контент: список чатов + состояния -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chats_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/home_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
            <include layout="@layout/row_chat_skeleton" />
        </LinearLayout>

        <!-- Пустое состояние в изящном стиле -->
        <LinearLayout
            android:id="@+id/home_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_menu_icon">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_chat"
                    app:tint="@color/tsuyu_blue" />
            </FrameLayout>

            <TextView
                android:id="@+id/home_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/no_chats_title"
                android:textColor="@color/tsuyu_white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/home_empty_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/no_chats_description"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_find_people"
                style="@style/Widget.Tsuyu.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/find_people" />
        </LinearLayout>

        <!-- Плавающий FAB создания нового диалога -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/home_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/find_people"
            android:visibility="gone"
            app:backgroundTint="@color/tsuyu_blue"
            app:fabSize="normal"
            app:shapeAppearanceOverlay="@style/TsuyuCircleShape"
            app:srcCompat="@drawable/ic_compose"
            app:tint="@color/tsuyu_white" />
    </FrameLayout>

</LinearLayout>
