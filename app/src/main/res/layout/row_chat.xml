<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_row_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Dialog row: 50dp avatar, 15sp name, 13sp preview, 11sp time (web .dialog) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min_height"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="14dp"
        android:paddingBottom="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/avatar_dialog"
            android:layout_height="@dimen/avatar_dialog"
            android:layout_marginEnd="@dimen/space_md">

            <TextView
                android:id="@+id/chat_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_fallback"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/tsuyu_white"
                android:textSize="19sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

            <View
                android:id="@+id/chat_online_dot"
                android:layout_width="@dimen/online_dot_web"
                android:layout_height="@dimen/online_dot_web"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chat_name"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/chat_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textColor="@color/tsuyu_time"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chat_preview_status"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="@dimen/space_2xs"
                    android:contentDescription=""
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chat_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tsuyu_preview"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/chat_pin"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription=""
                    android:src="@drawable/ic_pin"
                    android:visibility="gone"
                    app:tint="@color/tsuyu_secondary" />

                <TextView
                    android:id="@+id/chat_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:background="@drawable/bg_unread_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/chat_row_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_divider_row" />
</LinearLayout>
