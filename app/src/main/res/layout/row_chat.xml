<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_row_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/avatar_row"
            android:layout_height="@dimen/avatar_row">

            <TextView
                android:id="@+id/chat_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_fallback"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/tsuyu_white"
                android:textSize="20sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

            <View
                android:id="@+id/chat_online_dot"
                android:layout_width="@dimen/online_dot"
                android:layout_height="@dimen/online_dot"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chat_preview_status"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="@dimen/space_2xs"
                    android:contentDescription=""
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chat_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle"
                    android:textColor="@color/tsuyu_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:minWidth="44dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/chat_pin"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="@dimen/space_2xs"
                    android:contentDescription=""
                    android:src="@drawable/ic_pin"
                    android:visibility="gone"
                    app:tint="@color/tsuyu_secondary" />

                <TextView
                    android:id="@+id/chat_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_unread_badge"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/chat_row_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="@dimen/divider_inset"
        android:background="@color/tsuyu_border" />
</LinearLayout>
