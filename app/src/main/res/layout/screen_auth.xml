<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2xl"
        android:paddingTop="@dimen/space_3xl"
        android:paddingEnd="@dimen/space_2xl"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="@dimen/radius_xl">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_title"
                android:src="@drawable/ic_chat"
                app:tint="@color/tsuyu_blue" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/auth_title"
            android:textAppearance="@style/TextAppearance.Tsuyu.Logotype" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_2xl"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/auth_subtitle"
            android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Tsuyu.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Tsuyu.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/tsuyu_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_password"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_primary"
            style="@style/Widget.Tsuyu.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/auth_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_switch_mode"
            style="@style/Widget.Tsuyu.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_md"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:text="@string/auth_create_account" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_2xl"
            android:paddingBottom="@dimen/space_md">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription=""
                android:src="@drawable/ic_lock"
                app:tint="@color/tsuyu_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/private_dialogs"
                android:textAppearance="@style/TextAppearance.Tsuyu.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
