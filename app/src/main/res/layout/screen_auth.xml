<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Логотип приложения в современной карточке -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/tsuyu_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_title"
                android:src="@drawable/ic_chat"
                app:tint="@color/tsuyu_blue" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/auth_title"
            android:textColor="@color/tsuyu_white"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/auth_subtitle"
            android:textColor="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <!-- Поле ввода Сервера / Домена -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Tsuyu.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_server_url"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Адрес сервера (например: my-app.up.railway.app)"
                android:inputType="textUri"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Поле ввода Email -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Tsuyu.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_email"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Поле ввода Пароля -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Tsuyu.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/tsuyu_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_password"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Основная кнопка входа -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_primary"
            style="@style/Widget.Tsuyu.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/auth_login" />

        <!-- Кнопка переключения на регистрацию -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_switch_mode"
            style="@style/Widget.Tsuyu.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/auth_create_account" />

        <!-- Подвал: Индикатор E2EE шифрования -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription=""
                android:src="@drawable/ic_lock"
                app:tint="@color/tsuyu_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/private_dialogs"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
