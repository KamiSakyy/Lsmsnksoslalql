<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_gutter">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/poll_question_label"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/poll_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poll_question_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:maxLines="3"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/poll_options_label"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/poll_option_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poll_option_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/poll_option_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poll_option_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/poll_option_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poll_option_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/poll_option_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/poll_option_hint"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/poll_add_option"
        style="@style/Widget.Tsuyu.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/poll_add_option"
        android:textColor="@color/tsuyu_blue"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/tsuyu_blue" />
</LinearLayout>
