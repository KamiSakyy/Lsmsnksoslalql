<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tsuyu_surface"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/poll_question_label"
            android:textColor="@color/tsuyu_white"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/poll_question"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:fontFamily="sans-serif"
            android:hint="@string/poll_question_hint"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tsuyu_white"
            android:textColorHint="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/poll_options_label"
            android:textColor="@color/tsuyu_white"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/poll_option_1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:fontFamily="sans-serif"
            android:hint="@string/poll_option_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tsuyu_white"
            android:textColorHint="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/poll_option_2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:fontFamily="sans-serif"
            android:hint="@string/poll_option_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tsuyu_white"
            android:textColorHint="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/poll_option_3"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:fontFamily="sans-serif"
            android:hint="@string/poll_option_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tsuyu_white"
            android:textColorHint="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/poll_option_4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search"
            android:fontFamily="sans-serif"
            android:hint="@string/poll_option_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tsuyu_white"
            android:textColorHint="@color/tsuyu_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/poll_add_option"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/poll_add_option"
            android:textColor="@color/tsuyu_blue"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/tsuyu_blue" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
