<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black">
    <com.tsuyu.messenger.ui.ZoomImageView
        android:id="@+id/viewer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Просмотр изображения"
        android:scaleType="matrix" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Закрыть"
        android:minWidth="0dp"
        android:text=""
        app:backgroundTint="#99141416"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/tsuyu_white" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_download"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:text="Скачать"
        app:backgroundTint="@color/tsuyu_surface"
        app:cornerRadius="22dp" />
</FrameLayout>
