<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/notifications_sound_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Звук уведомлений"
        android:textColor="@color/tsuyu_white" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/notifications_choose_sound"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Выбрать звук из файлов"
        app:backgroundTint="@color/tsuyu_input"
        app:cornerRadius="16dp" />
</LinearLayout>
