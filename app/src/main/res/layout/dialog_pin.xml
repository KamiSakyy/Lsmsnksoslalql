<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_lg">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/drawer_pin"
        android:src="@drawable/ic_lock"
        app:tint="@color/tsuyu_white" />

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/pin_enter_title"
        android:textColor="@color/tsuyu_white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/pin_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/pin_enter_subtitle"
        android:textColor="@color/tsuyu_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/pin_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_pin_input"
        android:gravity="center"
        android:hint="@string/pin_enter_hint"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.4"
        android:maxLength="6"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/pin_wrong"
        android:textColor="@color/tsuyu_danger"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pin_cancel"
            style="@style/Widget.Tsuyu.MultiSelectButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/circle_cancel"
            android:textColor="@color/tsuyu_white" />

        <Button
            android:id="@+id/pin_confirm"
            style="@style/Widget.Tsuyu.MultiSelectButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:background="@drawable/bg_send_enabled"
            android:text="@string/pin_confirm"
            android:textColor="@color/tsuyu_white" />
    </LinearLayout>
</LinearLayout>
