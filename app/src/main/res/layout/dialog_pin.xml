<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_menu_icon">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@string/drawer_pin"
            android:src="@drawable/ic_lock"
            app:tint="@color/tsuyu_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/pin_enter_title"
        android:textColor="@color/tsuyu_white"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/pin_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/pin_enter_subtitle"
        android:textColor="@color/tsuyu_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/pin_input"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pin_input"
        android:fontFamily="monospace"
        android:gravity="center"
        android:hint="@string/pin_enter_hint"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.4"
        android:maxLength="6"
        android:textColor="@color/tsuyu_white"
        android:textColorHint="@color/tsuyu_secondary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/pin_wrong"
        android:textColor="@color/tsuyu_danger"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pin_cancel"
            style="@style/Widget.Tsuyu.MultiSelectButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/circle_cancel"
            android:textColor="@color/tsuyu_white" />

        <Button
            android:id="@+id/pin_confirm"
            style="@style/Widget.Tsuyu.MultiSelectButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_send_enabled"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pin_confirm"
            android:textColor="@color/tsuyu_white" />
    </LinearLayout>
</LinearLayout>
