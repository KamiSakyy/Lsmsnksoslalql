<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/tsuyu_outgoing"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/TsuyuMessageOutgoingShape">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">
            <ProgressBar android:id="@+id/message_loading" style="?android:attr/progressBarStyleSmall" android:layout_width="18dp" android:layout_height="18dp" android:indeterminateTint="@color/tsuyu_secondary" android:visibility="gone" />
            <TextView android:id="@+id/message_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="288dp" android:textColor="@color/tsuyu_white" android:textSize="14sp" />
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/message_image" android:layout_width="244dp" android:layout_height="190dp" android:layout_marginTop="2dp" android:scaleType="centerCrop" android:visibility="gone" app:shapeAppearanceOverlay="@style/TsuyuMessageOutgoingShape" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/message_gallery" android:layout_width="252dp" android:layout_height="136dp" android:layout_marginTop="2dp" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/message_video" android:layout_width="244dp" android:layout_height="150dp" android:layout_marginTop="2dp" android:clickable="true" android:visibility="gone" app:cardBackgroundColor="#111113" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_play" app:tint="@color/tsuyu_blue" /><TextView android:id="@+id/message_video_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Видео · нажмите для просмотра" android:textColor="@color/tsuyu_white" android:textSize="13sp" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/message_audio" android:layout_width="250dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:clickable="true" android:visibility="gone" app:cardBackgroundColor="#242426" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp"><com.google.android.material.button.MaterialButton android:id="@+id/message_audio_play" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="Воспроизвести" android:minWidth="0dp" android:text="" android:textColor="@color/tsuyu_blue" app:backgroundTint="#303034" app:cornerRadius="20dp" app:icon="@drawable/ic_play" app:iconTint="@color/tsuyu_blue" app:iconSize="17dp" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/message_audio_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Голосовое" android:textColor="@color/tsuyu_white" android:textSize="13sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Нажмите, чтобы прослушать" android:textColor="@color/tsuyu_secondary" android:textSize="10sp" /></LinearLayout></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/message_reaction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_security_pill" android:drawablePadding="5dp" android:drawableStart="@drawable/ic_heart" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:textColor="@color/tsuyu_white" android:textSize="11sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/message_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end|center_vertical" android:orientation="horizontal"><TextView android:id="@+id/message_edited" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="изменено" android:textColor="@color/tsuyu_secondary" android:textSize="10sp" android:visibility="gone" /><TextView android:id="@+id/message_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tsuyu_secondary" android:textSize="10sp" /><ImageView android:id="@+id/message_status" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="5dp" android:contentDescription="" android:scaleType="fitCenter" android:visibility="gone" /></LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/message_retry" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="end" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:text="@string/send_failed" android:textColor="@color/tsuyu_red" android:textSize="10sp" android:visibility="gone" app:backgroundTint="@color/tsuyu_surface" app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
