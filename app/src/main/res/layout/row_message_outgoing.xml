<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/tsuyu_outgoing"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/TsuyuMessageOutgoingShape"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="68dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp">

            <ProgressBar
                android:id="@+id/message_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/tsuyu_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:maxWidth="280dp"
                android:textColor="@color/tsuyu_white"
                android:textSize="14sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/message_image"
                android:layout_width="224dp"
                android:layout_height="176dp"
                android:layout_marginTop="2dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuMessageOutgoingShape" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/message_gallery"
                android:layout_width="224dp"
                android:layout_height="128dp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_video"
                android:layout_width="224dp"
                android:layout_height="138dp"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tsuyu_header"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_play"
                        app:tint="@color/tsuyu_blue" />
                    <TextView
                        android:id="@+id/message_video_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Открыть видео"
                        android:textColor="@color/tsuyu_white"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_audio"
                android:layout_width="224dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tsuyu_header"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="9dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_audio_play"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Воспроизвести"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text=""
                        app:backgroundTint="@color/tsuyu_surface"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_play"
                        app:iconSize="18dp"
                        app:iconTint="@color/tsuyu_blue" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/message_audio_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Голосовое"
                            android:textColor="@color/tsuyu_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Нажмите для прослушивания"
                            android:textColor="@color/tsuyu_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/message_reaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_security_pill"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/ic_heart"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/tsuyu_white"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/message_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/message_edited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="изменено"
                    android:textColor="@color/tsuyu_secondary"
                    android:textSize="10sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tsuyu_secondary"
                    android:textSize="11sp" />
                <ImageView
                    android:id="@+id/message_status"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription=""
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/message_retry"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/send_failed"
                android:textColor="@color/tsuyu_red"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="@color/tsuyu_surface"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
