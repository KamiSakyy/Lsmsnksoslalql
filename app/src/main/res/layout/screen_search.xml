<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar"
        style="@style/Widget.Tsuyu.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/search_people" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Tsuyu.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:layout_marginBottom="@dimen/space_md"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/tsuyu_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            style="@style/Widget.Tsuyu.Input.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_2xs"
            android:paddingBottom="@dimen/space_md"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/search_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3xl"
            android:paddingEnd="@dimen/space_3xl">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_menu_icon">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_search"
                    app:tint="@color/tsuyu_blue" />
            </FrameLayout>

            <TextView
                android:id="@+id/search_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/search_prompt"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
