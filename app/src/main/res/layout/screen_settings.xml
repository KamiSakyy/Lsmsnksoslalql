<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.Tsuyu.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Настройки" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_2xl">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_profile_card"
                style="@style/Widget.Tsuyu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/tsuyu_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_profile"
                        android:layout_height="@dimen/avatar_profile">

                        <TextView
                            android:id="@+id/settings_avatar_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar_fallback"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="@color/tsuyu_white"
                            android:textSize="21sp" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/settings_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/settings_profile_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Tsuyu.RowTitle"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/settings_profile_handle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2xs"
                            android:text="Открыть профиль"
                            android:textColor="@color/tsuyu_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_icon_size"
                        android:layout_height="@dimen/row_icon_size"
                        android:contentDescription=""
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/tsuyu_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Уведомления"
                android:textAppearance="@style/TextAppearance.Tsuyu.SectionLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Tsuyu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tsuyu_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_settings_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Новые сообщения"
                            android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Получать уведомления, когда приложение закрыто"
                            android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/background_sync_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Настройки приложения"
                android:textAppearance="@style/TextAppearance.Tsuyu.SectionLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Tsuyu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tsuyu_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/setting_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/row_settings_height"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/row_icon_tile"
                            android:layout_height="@dimen/row_icon_tile"
                            android:background="@drawable/bg_menu_icon">

                            <ImageView
                                android:layout_width="@dimen/row_icon_size"
                                android:layout_height="@dimen/row_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription=""
                                android:src="@drawable/ic_person"
                                app:tint="@color/tsuyu_blue" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Конфиденциальность"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Видимость профиля и отметки прочтения"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/row_icon_size"
                            android:layout_height="@dimen/row_icon_size"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tsuyu_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hairline"
                        android:layout_marginStart="68dp"
                        android:background="@color/tsuyu_border" />

                    <LinearLayout
                        android:id="@+id/setting_customization"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/row_settings_height"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/row_icon_tile"
                            android:layout_height="@dimen/row_icon_tile"
                            android:background="@drawable/bg_menu_icon">

                            <ImageView
                                android:layout_width="@dimen/row_icon_size"
                                android:layout_height="@dimen/row_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription=""
                                android:src="@drawable/ic_tune"
                                app:tint="@color/tsuyu_blue" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Внешний вид"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Размер и начертание текста"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/row_icon_size"
                            android:layout_height="@dimen/row_icon_size"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tsuyu_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hairline"
                        android:layout_marginStart="68dp"
                        android:background="@color/tsuyu_border" />

                    <LinearLayout
                        android:id="@+id/setting_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/row_settings_height"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/row_icon_tile"
                            android:layout_height="@dimen/row_icon_tile"
                            android:background="@drawable/bg_menu_icon">

                            <ImageView
                                android:layout_width="@dimen/row_icon_size"
                                android:layout_height="@dimen/row_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription=""
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/tsuyu_blue" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Звук и вибрация"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Настроить оповещения"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/row_icon_size"
                            android:layout_height="@dimen/row_icon_size"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tsuyu_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hairline"
                        android:layout_marginStart="68dp"
                        android:background="@color/tsuyu_border" />

                    <LinearLayout
                        android:id="@+id/setting_keys"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/row_settings_height"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/row_icon_tile"
                            android:layout_height="@dimen/row_icon_tile"
                            android:background="@drawable/bg_menu_icon">

                            <ImageView
                                android:layout_width="@dimen/row_icon_size"
                                android:layout_height="@dimen/row_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription=""
                                android:src="@drawable/ic_lock"
                                app:tint="@color/tsuyu_green" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Защита сообщений"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ваш код безопасности"
                                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/row_icon_size"
                            android:layout_height="@dimen/row_icon_size"
                            android:contentDescription=""
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/tsuyu_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_logout"
                style="@style/Widget.Tsuyu.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="Выйти из аккаунта" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_black"
        android:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.Tsuyu.NavLabelActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Tsuyu.NavLabel"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
