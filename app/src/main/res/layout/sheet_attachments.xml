<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attachment_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_gutter"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/sheet_gutter"
    android:paddingBottom="@dimen/space_xl">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вложения"
        android:textAppearance="@style/TextAppearance.Tsuyu.SheetTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:layout_marginBottom="@dimen/space_lg"
        android:text="Выберите, чем поделиться"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attachment_photo"
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="0dp"
            android:layout_height="@dimen/attachment_card_height"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Фото"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/tsuyu_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Фото"
                        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Одно"
                        android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attachment_photos"
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="0dp"
            android:layout_height="@dimen/attachment_card_height"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Несколько фото"
                    android:src="@drawable/ic_gallery"
                    app:tint="@color/tsuyu_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Коллаж"
                        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="До 6 фото"
                        android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attachment_video"
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="0dp"
            android:layout_height="@dimen/attachment_card_height"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Видео"
                    android:src="@drawable/ic_video"
                    app:tint="@color/tsuyu_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Видео"
                        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Клип"
                        android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attachment_audio"
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="0dp"
            android:layout_height="@dimen/attachment_card_height"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/tsuyu_surface"
            app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Аудиофайл"
                    android:src="@drawable/ic_audio"
                    app:tint="@color/tsuyu_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Аудио"
                        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Файл"
                        android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachment_voice"
        style="@style/Widget.Tsuyu.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_lg"
        android:contentDescription="Записать или отправить голосовое сообщение"
        android:text="Записать голосовое"
        android:textSize="14sp"
        app:icon="@drawable/ic_mic"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_sm"
        app:iconSize="20dp"
        app:iconTint="@color/tsuyu_blue" />
</LinearLayout>
