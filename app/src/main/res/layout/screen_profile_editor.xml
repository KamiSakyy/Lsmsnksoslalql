<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profile_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/tsuyu_header"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Редактировать профиль"
        app:titleTextColor="@color/tsuyu_white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:background="@drawable/bg_profile_cover">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="18dp"
                    android:letterSpacing="0.12"
                    android:text="TSUYU  ·  ЛИЧНЫЙ ПРОФИЛЬ"
                    android:textColor="#D7EAFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="142dp"
                    android:layout_height="142dp"
                    android:layout_gravity="top|end"
                    android:background="#223482FF"
                    android:translationX="34dp"
                    android:translationY="-44dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-46dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <FrameLayout
                    android:id="@+id/profile_avatar_container"
                    android:layout_width="106dp"
                    android:layout_height="106dp"
                    android:clickable="true"
                    android:contentDescription="Фото профиля"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/profile_avatar_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_fallback"
                        android:gravity="center"
                        android:textColor="@color/tsuyu_white"
                        android:textSize="42sp"
                        android:textStyle="bold" />
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Tsuyu.Circle" />
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/profile_pick_photo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="Изменить фото"
                        app:backgroundTint="@color/tsuyu_blue"
                        app:fabSize="mini"
                        app:srcCompat="@drawable/ic_person"
                        app:tint="@color/tsuyu_white" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Фото профиля" android:textColor="@color/tsuyu_white" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Коснитесь, чтобы изменить" android:textColor="@color/tsuyu_secondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/profile_name_hint"
                app:boxBackgroundColor="@color/tsuyu_input"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/tsuyu_blue">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/tsuyu_white" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/profile_username_hint"
                app:boxBackgroundColor="@color/tsuyu_input"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/tsuyu_blue"
                app:prefixText="@">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/profile_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/tsuyu_white" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/profile_about_hint"
                app:boxBackgroundColor="@color/tsuyu_input"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/tsuyu_blue">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3"
                    android:textColor="@color/tsuyu_white" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/profile_username_hint_text"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Сохранить профиль"
                android:textSize="15sp"
                app:backgroundTint="@color/tsuyu_blue"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
