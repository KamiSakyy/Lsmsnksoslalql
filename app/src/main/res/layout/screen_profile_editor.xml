<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profile_toolbar"
        style="@style/Widget.Tsuyu.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Редактировать профиль" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2xl"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/profile_avatar_container"
                    android:layout_width="@dimen/avatar_editor"
                    android:layout_height="@dimen/avatar_editor"
                    android:clickable="true"
                    android:contentDescription="Фото профиля"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/profile_avatar_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_fallback"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="@color/tsuyu_white"
                        android:textSize="38sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/profile_pick_photo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="Изменить фото"
                        app:backgroundTint="@color/tsuyu_blue"
                        app:fabSize="mini"
                        app:shapeAppearanceOverlay="@style/TsuyuCircleShape"
                        app:srcCompat="@drawable/ic_photo"
                        app:tint="@color/tsuyu_white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/profile_photo"
                    android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_photo_hint"
                    android:textAppearance="@style/TextAppearance.Tsuyu.Caption" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Tsuyu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_name"
                    style="@style/Widget.Tsuyu.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_name_hint"
                    android:inputType="textCapWords"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Tsuyu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_username"
                    style="@style/Widget.Tsuyu.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_username_hint"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Tsuyu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm">

                <!-- Описание адаптивное: поле ровно по тексту, от одной строки до пяти,
                     а длинная строка сама уменьшает кегль вместо переноса «лестницей». -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_about"
                    style="@style/Widget.Tsuyu.Input.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="top|start"
                    android:hint="@string/profile_about_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_save"
                style="@style/Widget.Tsuyu.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/space_md"
                android:text="Сохранить профиль" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
