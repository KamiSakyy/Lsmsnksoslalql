<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/message_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_date_pill"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/tsuyu_secondary"
        android:textSize="12sp" />
</FrameLayout>
