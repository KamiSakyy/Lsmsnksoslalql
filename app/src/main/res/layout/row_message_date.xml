<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_sm">

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:layout_weight="1"
        android:background="@color/tsuyu_border" />

    <TextView
        android:id="@+id/message_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textColor="@color/tsuyu_secondary"
        android:textSize="11sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:layout_weight="1"
        android:background="@color/tsuyu_border" />
</LinearLayout>
