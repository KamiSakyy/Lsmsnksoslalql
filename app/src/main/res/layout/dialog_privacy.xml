<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/privacy_ghost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Режим призрака" android:textColor="@color/tsuyu_white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="8dp" android:text="Скрой отметки прочтения. Доступность полей профиля также контролируется правилами RTDB." android:textColor="@color/tsuyu_secondary" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Кто может писать" android:textColor="@color/tsuyu_white" android:textSize="13sp" />
        <Spinner android:id="@+id/privacy_messages" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/tsuyu_blue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Кто видит время захода" android:textColor="@color/tsuyu_white" android:textSize="13sp" />
        <Spinner android:id="@+id/privacy_last_seen" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/tsuyu_blue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Кто видит фото" android:textColor="@color/tsuyu_white" android:textSize="13sp" />
        <Spinner android:id="@+id/privacy_photo" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/tsuyu_blue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Кто видит описание" android:textColor="@color/tsuyu_white" android:textSize="13sp" />
        <Spinner android:id="@+id/privacy_about" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/tsuyu_blue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Кто видит имя" android:textColor="@color/tsuyu_white" android:textSize="13sp" />
        <Spinner android:id="@+id/privacy_display_name" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/tsuyu_blue" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
