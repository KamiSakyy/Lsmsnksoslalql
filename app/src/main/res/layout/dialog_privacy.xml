<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_gutter">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/privacy_ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="Не показывать, что я в сети"
            android:textColor="@color/tsuyu_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:layout_marginBottom="@dimen/space_lg"
            android:lineSpacingMultiplier="1.2"
            android:text="Скройте отметки прочтения и выберите, кто может видеть данные вашего профиля."
            android:textAppearance="@style/TextAppearance.Tsuyu.Caption" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tsuyu_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_settings_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кто может писать"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />

            <Spinner
                android:id="@+id/privacy_messages"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/tsuyu_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/tsuyu_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_settings_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кто видит время захода"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />

            <Spinner
                android:id="@+id/privacy_last_seen"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/tsuyu_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/tsuyu_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_settings_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кто видит фото"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />

            <Spinner
                android:id="@+id/privacy_photo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/tsuyu_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/tsuyu_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_settings_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кто видит описание"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />

            <Spinner
                android:id="@+id/privacy_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/tsuyu_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/tsuyu_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_settings_height"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кто видит имя"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />

            <Spinner
                android:id="@+id/privacy_display_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="2dp"
                android:backgroundTint="@color/tsuyu_blue" />
        </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
