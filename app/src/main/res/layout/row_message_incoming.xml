<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_bubble"
        android:layout_gravity="start"
        style="@style/Widget.Tsuyu.Bubble.Incoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/bubble_gutter"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="68dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/bubble_padding_horizontal"
            android:paddingTop="@dimen/bubble_padding_top"
            android:paddingEnd="@dimen/bubble_padding_horizontal"
            android:paddingBottom="@dimen/bubble_padding_bottom">

            <ProgressBar
                android:id="@+id/message_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/tsuyu_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="@dimen/bubble_text_max_width"
                android:textAppearance="@style/TextAppearance.Tsuyu.Body" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/message_image"
                android:layout_width="@dimen/media_width"
                android:layout_height="@dimen/media_height_image"
                android:layout_marginTop="@dimen/space_xs"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuMediaShape" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/message_gallery"
                android:layout_width="@dimen/media_width"
                android:layout_height="@dimen/media_height_gallery"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_video"
                style="@style/Widget.Tsuyu.Card.Inset"
                android:layout_width="@dimen/media_width"
                android:layout_height="@dimen/media_height_video"
                android:layout_marginTop="@dimen/space_xs"
                android:clickable="true"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_play"
                        app:tint="@color/tsuyu_blue" />

                    <TextView
                        android:id="@+id/message_video_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="Открыть видео"
                        android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle"
                        android:textColor="@color/tsuyu_white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <FrameLayout
                android:id="@+id/message_circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/message_circle_card"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:cardBackgroundColor="@color/tsuyu_black"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <VideoView
                        android:id="@+id/message_circle_video"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <ProgressBar
                    android:id="@+id/message_circle_progress"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/tsuyu_white" />

                <ImageView
                    android:id="@+id/message_circle_play"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/circle_play"
                    android:src="@drawable/ic_play"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    android:id="@+id/message_circle_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_circle_time"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="0:00"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="11sp" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_audio"
                style="@style/Widget.Tsuyu.Card.Inset"
                android:layout_width="@dimen/media_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:clickable="true"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_audio_play"
                        style="@style/Widget.Tsuyu.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Воспроизвести"
                        app:backgroundTint="@color/tsuyu_surface"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_play"
                        app:iconSize="18dp"
                        app:iconTint="@color/tsuyu_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/message_audio_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Голосовое"
                            android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Нажмите для прослушивания"
                            android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/message_reaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_security_pill"
                android:drawablePadding="@dimen/space_2xs"
                android:drawableStart="@drawable/ic_heart"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_2xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_2xs"
                android:textColor="@color/tsuyu_white"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/message_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/message_edited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2xs"
                    android:text="изменено"
                    android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />

                <ImageView
                    android:id="@+id/message_status"
                    android:layout_width="@dimen/status_icon"
                    android:layout_height="@dimen/status_icon"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription=""
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/message_retry"
                style="@style/Widget.Tsuyu.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/icon_button_small"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/space_2xs"
                android:text="@string/send_failed"
                android:textColor="@color/tsuyu_red"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="@color/tsuyu_surface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/message_swipe_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/space_sm"
        android:alpha="0"
        android:contentDescription=""
        android:src="@drawable/ic_reply"
        app:tint="@color/tsuyu_secondary" />
</FrameLayout>
