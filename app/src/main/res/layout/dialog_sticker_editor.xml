<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_gutter">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sticker_editor_title"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:text="@string/sticker_editor_hint"
        android:textAppearance="@style/TextAppearance.Tsuyu.Timestamp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@color/tsuyu_black">

        <com.tsuyu.messenger.ui.StickerCanvas
            android:id="@+id/sticker_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/sticker_editor_title" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sticker_color_1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_sticker_color"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="@string/sticker_brush"
            android:focusable="true" />
        <ImageView
            android:id="@+id/sticker_color_2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_sticker_color"
            android:backgroundTint="#7B61FF"
            android:clickable="true"
            android:contentDescription="@string/sticker_brush"
            android:focusable="true" />
        <ImageView
            android:id="@+id/sticker_color_3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_sticker_color"
            android:backgroundTint="#FF3B30"
            android:clickable="true"
            android:contentDescription="@string/sticker_brush"
            android:focusable="true" />
        <ImageView
            android:id="@+id/sticker_color_4"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_sticker_color"
            android:backgroundTint="#00C781"
            android:clickable="true"
            android:contentDescription="@string/sticker_brush"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/sticker_brush"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sticker_brush"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_brush"
        android:stepSize="1"
        android:value="10"
        android:valueFrom="3"
        android:valueTo="34"
        app:thumbColor="@color/tsuyu_blue"
        app:trackColorActive="@color/tsuyu_blue"
        app:trackColorInactive="@color/tsuyu_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sticker_threshold"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sticker_threshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/sticker_threshold"
        android:stepSize="0.05"
        android:value="0.78"
        android:valueFrom="0.3"
        android:valueTo="0.98"
        app:thumbColor="@color/tsuyu_burn"
        app:trackColorActive="@color/tsuyu_burn"
        app:trackColorInactive="@color/tsuyu_border" />
</LinearLayout>
