<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="18dp"
    android:paddingBottom="@dimen/space_xl">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Действия в чате"
        android:textAppearance="@style/TextAppearance.Tsuyu.SheetTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:layout_marginBottom="@dimen/space_md"
        android:text="Переписка, профиль и безопасность"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

    <LinearLayout
        android:id="@+id/chat_menu_profile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_sheet_action_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/row_icon_tile"
            android:layout_height="@dimen/row_icon_tile"
            android:background="@drawable/bg_menu_icon">

            <ImageView
                android:layout_width="@dimen/row_icon_size"
                android:layout_height="@dimen/row_icon_size"
                android:layout_gravity="center"
                android:contentDescription=""
                android:src="@drawable/ic_person"
                app:tint="@color/tsuyu_blue" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Профиль собеседника"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Фото, имя и сведения"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_menu_export"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_sheet_action_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/row_icon_tile"
            android:layout_height="@dimen/row_icon_tile"
            android:background="@drawable/bg_menu_icon">

            <ImageView
                android:layout_width="@dimen/row_icon_size"
                android:layout_height="@dimen/row_icon_size"
                android:layout_gravity="center"
                android:contentDescription=""
                android:src="@drawable/ic_export"
                app:tint="@color/tsuyu_secondary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Экспорт переписки"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Сохранить сообщения в файл"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_menu_keys"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_sheet_action_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/row_icon_tile"
            android:layout_height="@dimen/row_icon_tile"
            android:background="@drawable/bg_menu_icon">

            <ImageView
                android:layout_width="@dimen/row_icon_size"
                android:layout_height="@dimen/row_icon_size"
                android:layout_gravity="center"
                android:contentDescription=""
                android:src="@drawable/ic_lock"
                app:tint="@color/tsuyu_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Код безопасности"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowItemTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Сверить защиту сообщений"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
