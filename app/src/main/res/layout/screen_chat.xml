<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2xs"
        android:paddingEnd="@dimen/space_2xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_back"
            style="@style/Widget.Tsuyu.IconButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:contentDescription="Назад к чатам"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="22dp"
            app:iconTint="@color/tsuyu_white" />

        <FrameLayout
            android:id="@+id/chat_peer_avatar_frame"
            android:layout_width="@dimen/avatar_header"
            android:layout_height="@dimen/avatar_header"
            android:layout_marginStart="@dimen/space_2xs"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/chat_peer_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_fallback"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/tsuyu_white"
                android:textSize="17sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_peer_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

            <View
                android:id="@+id/chat_peer_online_dot"
                android:layout_width="@dimen/online_dot"
                android:layout_height="@dimen/online_dot"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/chat_peer_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_peer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Собеседник"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowTitle" />

            <TextView
                android:id="@+id/chat_peer_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Tsuyu.RowMeta" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_more"
            style="@style/Widget.Tsuyu.IconButton"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:contentDescription="Действия в чате"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_more"
            app:iconSize="22dp"
            app:iconTint="@color/tsuyu_white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/chat_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3xl"
            android:paddingEnd="@dimen/space_3xl"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_menu_icon">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_chat"
                    app:tint="@color/tsuyu_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="Пока тихо"
                android:textAppearance="@style/TextAppearance.Tsuyu.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="Поздоровайтесь первым — сообщение появится здесь."
                android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chat_scroll_bottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_md"
            android:contentDescription="@string/chat_scroll_bottom"
            android:visibility="gone"
            app:backgroundTint="@color/tsuyu_input"
            app:elevation="0dp"
            app:fabSize="mini"
            app:shapeAppearanceOverlay="@style/TsuyuCircleShape"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/tsuyu_white" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reply_banner"
        style="@style/Widget.Tsuyu.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_xs"
        android:visibility="gone"
        app:cardBackgroundColor="@color/tsuyu_surface"
        app:cardCornerRadius="@dimen/radius_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bubble_padding_horizontal"
            android:paddingTop="@dimen/space_2xs"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_2xs">

            <View
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:layout_marginEnd="@dimen/space_md"
                android:background="@drawable/bg_sheet_handle"
                android:backgroundTint="@color/tsuyu_blue" />

            <TextView
                android:id="@+id/reply_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textColor="@color/tsuyu_blue"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reply_cancel"
                style="@style/Widget.Tsuyu.IconButton"
                android:layout_width="@dimen/icon_button_small"
                android:layout_height="@dimen/icon_button_small"
                android:contentDescription="Отменить ответ"
                app:cornerRadius="@dimen/radius_pill"
                app:icon="@drawable/ic_close"
                app:iconSize="17dp"
                app:iconTint="@color/tsuyu_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/composer_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_attach"
            style="@style/Widget.Tsuyu.IconButton"
            android:layout_width="@dimen/icon_button_dense"
            android:layout_height="@dimen/icon_button_dense"
            android:contentDescription="Прикрепить"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_add"
            app:iconSize="22dp"
            app:iconTint="@color/tsuyu_secondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/composer_layout"
            style="@style/Widget.Tsuyu.Input.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chat_composer"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chat_message_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="@dimen/icon_button_dense"
                android:textColor="@color/tsuyu_white"
                android:textColorHint="@color/tsuyu_secondary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_send"
            style="@style/Widget.Tsuyu.IconButton"
            android:layout_width="@dimen/icon_button_dense"
            android:layout_height="@dimen/icon_button_dense"
            android:contentDescription="Отправить сообщение"
            app:backgroundTint="@color/tsuyu_blue"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_send"
            app:iconSize="20dp"
            app:iconTint="@color/tsuyu_white" />
    </LinearLayout>
</LinearLayout>
