<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black"
    android:orientation="vertical">

    <!-- Верхняя панель диалога (Header) -->
    <LinearLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_header_back"
            android:clickable="true"
            android:contentDescription="Назад к чатам"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/tsuyu_white" />

        <FrameLayout
            android:id="@+id/chat_peer_avatar_frame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/chat_peer_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_fallback"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/tsuyu_white"
                android:textSize="17sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_peer_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

            <View
                android:id="@+id/chat_peer_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/chat_peer_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_peer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/tsuyu_white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chat_peer_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chat_video_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/call_menu_video"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_video"
            app:tint="@color/tsuyu_white" />

        <ImageView
            android:id="@+id/chat_voice_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/call_menu_audio"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_call"
            app:tint="@color/tsuyu_white" />

        <ImageView
            android:id="@+id/chat_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="Ещё"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_more"
            app:tint="@color/tsuyu_white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <!-- Закреплённое сообщение -->
    <LinearLayout
        android:id="@+id/chat_pinned_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pinned_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_sheet_handle"
            android:backgroundTint="@color/tsuyu_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pinned_message_title"
                android:textColor="@color/tsuyu_blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pinned_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tsuyu_white"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinned_message_close"
            style="@style/Widget.Tsuyu.IconButton"
            android:layout_width="@dimen/icon_button_small"
            android:layout_height="@dimen/icon_button_small"
            android:contentDescription="@string/msg_unpin"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/ic_close"
            app:iconSize="18dp"
            app:iconTint="@color/tsuyu_secondary" />
    </LinearLayout>

    <!-- Область сообщений -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/chat_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <!-- Пустое состояние диалога -->
        <LinearLayout
            android:id="@+id/chat_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_menu_icon">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_chat"
                    app:tint="@color/tsuyu_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Пока тихо"
                android:textAppearance="@style/TextAppearance.Tsuyu.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Поздоровайтесь первым — сообщение появится здесь."
                android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />
        </LinearLayout>

        <!-- Кнопка прокрутки к свежим сообщениям -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chat_scroll_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/chat_scroll_bottom"
            android:visibility="gone"
            app:backgroundTint="@color/tsuyu_surface"
            app:elevation="4dp"
            app:fabCustomSize="44dp"
            app:shapeAppearanceOverlay="@style/TsuyuCircleShape"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/tsuyu_white" />
    </FrameLayout>

    <!-- Панель ответа / редактирования -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reply_banner"
        style="@style/Widget.Tsuyu.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/tsuyu_surface"
        app:cardCornerRadius="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_sheet_handle"
                android:backgroundTint="@color/tsuyu_blue" />

            <TextView
                android:id="@+id/reply_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/tsuyu_white"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reply_cancel"
                style="@style/Widget.Tsuyu.IconButton"
                android:layout_width="@dimen/icon_button_small"
                android:layout_height="@dimen/icon_button_small"
                android:contentDescription="Отменить ответ"
                app:cornerRadius="@dimen/radius_pill"
                app:icon="@drawable/ic_close"
                app:iconSize="17dp"
                app:iconTint="@color/tsuyu_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Панель ввода (Composer) -->
    <LinearLayout
        android:id="@+id/composer_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/chat_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_clip"
            app:tint="@color/tsuyu_white" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/composer_layout"
            style="@style/Widget.Tsuyu.Input.Pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/chat_composer"
                style="@style/Widget.Tsuyu.Input.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chat_message_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="40dp"
                android:textColor="@color/tsuyu_white"
                android:textColorHint="@color/tsuyu_time"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/chat_voice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/tsuyu_white" />

        <ImageView
            android:id="@+id/chat_circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_circle_msg"
            app:tint="@color/tsuyu_white" />

        <ImageView
            android:id="@+id/chat_sticker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_header_btn"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/tsuyu_white" />

        <ImageView
            android:id="@+id/chat_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_scroll_fab"
            android:clickable="true"
            android:contentDescription="Отправить сообщение"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            android:visibility="gone"
            app:tint="@color/tsuyu_white" />
    </LinearLayout>

    <!-- Панель мультивыбора -->
    <LinearLayout
        android:id="@+id/multi_select_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/tsuyu_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/multi_select_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/multi_select_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/tsuyu_white" />

        <TextView
            android:id="@+id/multi_select_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/tsuyu_white"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/multi_select_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_multi_select_btn"
            android:contentDescription="@string/multi_select_delete"
            android:padding="9dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/tsuyu_red" />

        <ImageView
            android:id="@+id/multi_select_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_multi_select_btn"
            android:contentDescription="Переслать"
            android:padding="9dp"
            android:src="@drawable/ic_reply"
            app:tint="@color/tsuyu_blue" />
    </LinearLayout>

</LinearLayout>
