<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_md">

        <View
            android:layout_width="@dimen/avatar_row"
            android:layout_height="@dimen/avatar_row"
            android:background="@drawable/bg_avatar_fallback" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="132dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton_line" />

            <View
                android:layout_width="188dp"
                android:layout_height="11dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_skeleton_line" />
        </LinearLayout>

        <View
            android:layout_width="30dp"
            android:layout_height="11dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_line" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="@dimen/divider_inset"
        android:background="@color/tsuyu_border" />
</LinearLayout>
