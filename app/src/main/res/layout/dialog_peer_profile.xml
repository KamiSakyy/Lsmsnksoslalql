<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/avatar_hero"
                android:layout_height="@dimen/avatar_hero">

                <TextView
                    android:id="@+id/peer_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_fallback"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="34sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/peer_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />
            </FrameLayout>

            <TextView
                android:id="@+id/peer_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Tsuyu.ToolbarTitle" />

            <TextView
                android:id="@+id/peer_profile_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="center"
                android:textColor="@color/tsuyu_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/peer_profile_about"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textAppearance="@style/TextAppearance.Tsuyu.Body"
            android:textColor="@color/tsuyu_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            app:cardBackgroundColor="@color/tsuyu_header"
            app:cardCornerRadius="@dimen/radius_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Код безопасности"
                    android:textAppearance="@style/TextAppearance.Tsuyu.SectionLabel" />

                <TextView
                    android:id="@+id/peer_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Загрузка…"
                    android:textAppearance="@style/TextAppearance.Tsuyu.Mono"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_trust_key"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_md"
            android:text="Сверить код безопасности"
            android:textColor="@color/tsuyu_blue"
            app:backgroundTint="@color/tsuyu_accent_tint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_contact_button"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_md"
            android:text="Добавить в контакты" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_access_button"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Разрешить доступ по списку" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
