<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tsuyu_surface"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Шапка: Аватар + Имя + Юзернейм (Telegram-style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp">

                <TextView
                    android:id="@+id/peer_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_fallback"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="32sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/peer_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />
            </FrameLayout>

            <TextView
                android:id="@+id/peer_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/tsuyu_white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/peer_profile_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:textColor="@color/tsuyu_blue"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- О себе (Bio) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/tsuyu_header"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="О себе"
                    android:textColor="@color/tsuyu_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/peer_profile_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Карточка E2EE шифрования и безопасности -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/tsuyu_header"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Код безопасности E2EE"
                    android:textColor="@color/tsuyu_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/peer_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="Загрузка…"
                    android:textColor="@color/tsuyu_white"
                    android:textSize="12sp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Кнопки действий -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_trust_key"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Сверить код безопасности"
            android:textColor="@color/tsuyu_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_contact_button"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Добавить в контакты" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/peer_access_button"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Разрешить доступ по списку" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
