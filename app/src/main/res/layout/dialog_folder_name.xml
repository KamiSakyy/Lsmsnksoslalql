<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_gutter"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/dialog_gutter"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/folder_name_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/folder_name_hint"
        android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        style="@style/Widget.Tsuyu.Input">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/folder_name_input"
            style="@style/Widget.Tsuyu.Input.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/folder_name"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="24"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
