<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_root"
    android:layout_width="@dimen/drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/tsuyu_surface"
    android:orientation="vertical">

    <!-- Шапка профиля Telegram-style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tsuyu_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/drawer_avatar_frame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_avatar_ring"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/drawer_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/tsuyu_white"
                android:textSize="24sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawer_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/TsuyuCircleShape" />

            <ImageView
                android:id="@+id/drawer_avatar_edit"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_avatar_edit"
                android:clickable="true"
                android:contentDescription="@string/drawer_avatar_edit"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/tsuyu_black" />
        </FrameLayout>

        <TextView
            android:id="@+id/drawer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/tsuyu_white"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/drawer_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/drawer_online"
            android:textColor="@color/tsuyu_green"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/drawer_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/drawer_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="@string/drawer_status_hint"
                android:textColor="@color/tsuyu_secondary"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription=""
                android:src="@drawable/ic_edit"
                app:tint="@color/tsuyu_secondary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tsuyu_border" />

    <!-- Список разделов -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <!-- Избранное / Облако -->
            <LinearLayout
                android:id="@+id/drawer_item_cloud"
                style="@style/Widget.Tsuyu.DrawerRow">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_cloud" />
            </LinearLayout>

            <!-- Редактировать профиль -->
            <LinearLayout
                android:id="@+id/drawer_item_profile"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_person"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_edit_profile" />
            </LinearLayout>

            <!-- Сменить фото -->
            <LinearLayout
                android:id="@+id/drawer_item_avatar"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_gallery"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_change_avatar" />
            </LinearLayout>

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/tsuyu_border" />

            <!-- Режим невидимки -->
            <LinearLayout
                android:id="@+id/drawer_item_stealth"
                style="@style/Widget.Tsuyu.DrawerRow">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_eye_off"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_stealth" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/drawer_switch_stealth"
                    style="@style/Widget.Tsuyu.DrawerSwitch" />
            </LinearLayout>

            <!-- Звуки -->
            <LinearLayout
                android:id="@+id/drawer_item_sound"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_sound" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/drawer_switch_sound"
                    style="@style/Widget.Tsuyu.DrawerSwitch" />
            </LinearLayout>

            <!-- Сквозное шифрование -->
            <LinearLayout
                android:id="@+id/drawer_item_encrypt"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_lock"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_e2ee" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/drawer_switch_encrypt"
                    style="@style/Widget.Tsuyu.DrawerSwitch" />
            </LinearLayout>

            <!-- PIN-код -->
            <LinearLayout
                android:id="@+id/drawer_item_pin"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_lock"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    android:id="@+id/drawer_pin_label"
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_pin" />
            </LinearLayout>

            <!-- Кэш памяти -->
            <LinearLayout
                android:id="@+id/drawer_item_cache"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="2dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    android:id="@+id/drawer_cache_label"
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_cache" />
            </LinearLayout>

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/tsuyu_border" />

            <!-- Настройки -->
            <LinearLayout
                android:id="@+id/drawer_item_settings"
                style="@style/Widget.Tsuyu.DrawerRow">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_settings"
                    app:tint="@color/tsuyu_white" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_settings" />
            </LinearLayout>

            <!-- Выход -->
            <LinearLayout
                android:id="@+id/drawer_item_logout"
                style="@style/Widget.Tsuyu.DrawerRow"
                android:layout_marginTop="4dp">

                <ImageView
                    style="@style/Widget.Tsuyu.DrawerIcon"
                    android:contentDescription=""
                    android:src="@drawable/ic_logout"
                    app:tint="@color/tsuyu_red" />

                <TextView
                    style="@style/Widget.Tsuyu.DrawerLabel"
                    android:text="@string/drawer_logout"
                    android:textColor="@color/tsuyu_red" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
