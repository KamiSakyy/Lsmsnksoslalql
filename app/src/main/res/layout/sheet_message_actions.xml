<?xml version="1.0" encoding="utf-8"?>
<!-- Message action sheet, mirrors the web client .action-sheet markup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:padding="@dimen/sheet_padding">

    <LinearLayout
        android:id="@+id/message_reply"
        style="@style/Widget.Tsuyu.SheetActionRow">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_reply" />

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_reply" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_pin"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_pin" />

        <TextView
            android:id="@+id/message_pin_label"
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_pin" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_forward"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_export" />

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_forward" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_copy"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_copy" />

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_copy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_edit"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_edit" />

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_edit" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_delete"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap">

        <ImageView
            style="@style/Widget.Tsuyu.SheetActionIcon"
            android:contentDescription=""
            android:src="@drawable/ic_delete"
            app:tint="@color/tsuyu_danger" />

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_delete"
            android:textColor="@color/tsuyu_danger" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_cancel"
        style="@style/Widget.Tsuyu.SheetActionRow"
        android:layout_marginTop="@dimen/sheet_gap"
        android:gravity="center">

        <TextView
            style="@style/Widget.Tsuyu.SheetActionLabel"
            android:text="@string/msg_cancel"
            android:textColor="@color/tsuyu_preview" />
    </LinearLayout>

    <!-- Kept for compatibility with the existing sheet logic; never shown. -->
    <View
        android:id="@+id/message_react"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/message_actions_divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
