<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_gutter">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="Секретные данные хранятся на этом устройстве. Сверьте код безопасности с собеседником, чтобы убедиться, что вы общаетесь именно с ним."
            android:textAppearance="@style/TextAppearance.Tsuyu.RowSubtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Мой код безопасности"
            android:textAppearance="@style/TextAppearance.Tsuyu.SectionLabel" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tsuyu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:cardBackgroundColor="@color/tsuyu_header"
            app:cardCornerRadius="@dimen/radius_md">

            <TextView
                android:id="@+id/key_fingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.Tsuyu.Mono"
                android:textIsSelectable="true" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_copy_bundle"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_md"
            android:text="Скопировать код безопасности" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_rotate"
            style="@style/Widget.Tsuyu.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Обновить код безопасности" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
