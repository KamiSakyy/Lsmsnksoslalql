<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsuyu_black">
    <VideoView
        android:id="@+id/viewer_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_video_toggle"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:contentDescription="Воспроизведение"
        android:minWidth="0dp"
        android:text=""
        app:backgroundTint="#AA141416"
        app:cornerRadius="29dp"
        app:icon="@drawable/ic_pause"
        app:iconSize="24dp"
        app:iconTint="@color/tsuyu_white" />
</FrameLayout>
